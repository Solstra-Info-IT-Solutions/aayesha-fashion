# URL of the deployed Express API. Locally, the Next.js rewrite uses port 4000.
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=https://aayesha-fashion-backend.onrender.com/api

# Public Google OAuth client ID only. Never add GOOGLE_CLIENT_SECRET here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_RECIPIENT_NUMBER=918810330687